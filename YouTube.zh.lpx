#!name = YouTube 去广告
#!desc = 去除 YouTube App 广告,支持后台播放,并可翻译已有字幕轨道(目标语言 zh-CN 或 en-US,没有字幕的视频无法翻译)。日志默认只记录媒体响应头,完整采样可能增加延迟。需要开启 MITM 并信任证书。
#!openUrl = https://loon-plugins.vercel.app
#!author = devchristian1337
#!tag = YouTube, AdBlock
#!loon_version = 3.5.1(983)
#!homepage = https://github.com/devchristian1337/loon-plugins/blob/main/README.md
#!icon = https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/App-Icons/youtube.png
#!date = 2026-10-31

[Argument]
background_playback = switch,false,tag=后台播放,desc=切换 App 或锁屏后,普通视频继续播放音频。直播和受限内容仍由 YouTube 决定
playback_region = select,"original","CN","HK","TW","US","JP","KR","SG","GB","DE","RU",tag=播放请求地区,desc=original 表示保持当前地区。仅修改客户端 gl 参数,出口 IP 不变。去广告效果有待验证
translation_enabled = switch,false,tag=字幕翻译,desc=将已有字幕翻译为所选目标语言。关闭时保持原始字幕请求
translation_target = select,"zh-CN","en-US",tag=字幕目标语言,desc=仅转换已有字幕轨道(简体中文 zh-CN 或美式英语 en-US)。没有字幕的视频无法翻译;音轨、标题和简介不变
hide_home_shorts = switch,false,tag=隐藏首页 Shorts,desc=Removes the Shorts shelf from the Home feed. Other pages are kept, the bottom Shorts tab has its own switch
hide_shorts_tab = switch,false,tag=Hide Shorts tab,desc=Removes the Shorts button from the bottom bar of the app. Shorts stay reachable from the feed and from channels. The app caches the bar for about an hour, so restart it to see the change
hide_create_button = switch,false,tag=Hide Create button,desc=Removes the Create (+) button from the bottom bar of the app. Uploads stay possible from other entry points. The app caches the bar for about an hour, so restart it to see the change
blocked_channels = input,"",tag=屏蔽频道,desc=填写频道 ID、@用户名或完整频道名称,用空格分隔。优先使用频道 ID;名称含空格时请使用用户名或 ID。留空则不启用。只隐藏能识别出发布者的视频
blocked_channels_url = input,"",tag=远程屏蔽频道链接,desc=Public HTTPS plain-text direct link (e.g. GitHub Raw). Local cache refreshes hourly when the scheduled update is on. To refresh now, with the scheduled update on, run its script manually from the plugin script list. Merged with the manual list. Leave empty to disable
blocked_channels_update = switch,false,tag=Blocked channels scheduled update,desc=Refreshes the remote blocked channels list every hour. Only needed with a remote list URL: when off, the hourly task is disabled and cannot be run manually either, so the cached list stays as it is
log_enabled = switch,false,tag=日志工具,desc=首次匹配到请求时自动启动,并通知日志入口。关闭后,下一次 API 命中会清除日志并停止采样,需要的话请先下载。完整采样可能增加延迟
quality_research = switch,false,tag=质量研究采样,desc=仅在日志工具开启时生效。记录可识别的画质与格式参数,并读取小型媒体 POST 请求用于对比。不会自动切换画质
media_capture_mode = select,"headers","full",tag=媒体采样模式,desc=仅在日志工具开启时生效,日志关闭时自动停用。headers 只记录响应头;full 读取完整响应用于开发,可能增加延迟
log_level = select,"info","debug","warn","error",tag=日志级别,desc=info 保留完整的脱敏记录;error 仅保留错误;debug 保留调试级别;warn 保留警告和错误
capture_budget = select,"32","16","64",tag=日志容量(MB),desc=达到上限后停止记录,已有样本保留。导出后请清空

[Rule]
# 强制 API 和播放协商从 QUIC 回退到 TCP,以便 MITM/脚本检查。不拒绝媒体正文。
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,youtubei-att.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
# 按 QUIC 协议匹配 googlevideo 域名及子域名,UDP/443 作为兜底。
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Rewrite]
# 仅 YouTube App 的 init POST 返回 Loon 内置空白视频。不读取正文,普通媒体不受影响。
# 2026-10-05 更新。取代失败的 HTTP 204 方案。播放回退恢复仍需真机验证。
request if ${url} ~= /^https:\/\/[a-z0-9-]+\.googlevideo\.com\/initplayback(?:\?[^#]*)?$/i && ${request.method} == "POST" && ${request.header['User-Agent']} ~= /(?:^|\s)com\.google\.ios\.youtube\//i then reject_video(200)
# 清除媒体源的备用连接提示,减少拒绝 QUIC 后的重试。仅修改响应头。
# 2026-10-05 更新。实际启动延迟仍需真机验证,客户端可能使用其他 HTTP/3 发现方式。
^https://(?:[\w-]+\.)*googlevideo\.com(?::443)?/ response-header-replace Alt-Svc clear

[Script]
# 独立刷新频道列表缓存。信息流脚本只读缓存,不会等待远程下载。
# Updated 2026-10-28. Runs only when the scheduled update switch is on, so users without a remote list do not get an hourly task. Loon can also run this cron script manually from the script list, so no separate generic script is needed.
cron "0 * * * *" script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/YouTube/request.min.js,timeout=10,enable={blocked_channels_update},argument=[{blocked_channels_url}],tag=YouTube 定时更新屏蔽频道
http-request ^https:\/\/(?:www\.|m\.)?youtube\.com\/api\/timedtext\?[^#]+$ script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/YouTube/request.min.js,requires-body=false,timeout=10,enable={translation_enabled},argument=[{translation_enabled},{translation_target}],tag=YouTube 字幕目标语言
# 仅在日志和质量研究都明确开启时读取 videoplayback POST。不会命中空白 init 视频。
# 2026-10-07 更新。必须排在常规日志入口之前,默认不缓冲正文。
request if ${url} ~= /^https:\/\/[\w-]+\.googlevideo\.com\/videoplayback(?:\?[^#]*)?$/i && ${request.method} == "POST" && ${log_enabled} == true && ${quality_research} == true then script("https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/YouTube/request.min.js", {${log_enabled}, ${log_level}, ${capture_budget}, ${quality_research}}) with requires_body=true, binary_body_mode=true, timeout=10, tag="YouTube 质量研究请求采样"
http-request ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:browse|next|search|reel\/reel_watch_sequence)(?:\?[^#]*)?$|^https:\/\/[\w-]+\.googlevideo\.com\/videoplayback\?[^#]*$|^http:\/\/youtube-logs\.invalid(?::80)?(?:\/[^#]*)?$|^https:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/YouTube/request.min.js,requires-body=false,timeout=10,enable={log_enabled},argument=[{log_enabled},{log_level},{capture_budget},{background_playback},{media_capture_mode},{quality_research}],tag=YouTube 日志与导出
http-request ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.)?youtube\.com)\/youtubei\/v1\/log_event(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/YouTube/request.min.js,requires-body=true,binary-body-mode=true,timeout=10,argument=[{log_enabled},{log_level},{capture_budget},{playback_region}],tag=YouTube 配置请求处理
# 媒体采样由日志总开关控制。关闭时,响应头采样和完整采样都不运行。保存的模式选项不代表采样已启用。
# 完整采样必须在接收正文之前选定。同一响应只运行第一个匹配的脚本。默认的响应头入口不传 full,避免误读正文。
response if ${url} ~= /^https:\/\/[\w-]+\.googlevideo\.com\/(?:videoplayback|initplayback)(?:\?[^#]*)?$/i && ${log_enabled} == true && ${media_capture_mode} == "full" then script("https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/YouTube/response.min.js", {${log_enabled}, ${log_level}, ${capture_budget}, ${media_capture_mode}}) with requires_body=true, binary_body_mode=true, timeout=30, tag="YouTube 完整媒体开发采样"
http-response ^https:\/\/[\w-]+\.googlevideo\.com\/(?:videoplayback|initplayback)(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/YouTube/response.min.js,requires-body=false,timeout=10,enable={log_enabled},argument=[{log_enabled},{log_level},{capture_budget}],tag=YouTube 媒体响应日志
http-response ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.)?youtube\.com)\/youtubei\/v1\/(?:config|log_event)(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/YouTube/response.min.js,requires-body=true,binary-body-mode=true,timeout=10,argument=[{log_enabled},{log_level},{capture_budget}],tag=YouTube Onesie 配置缓存

http-request ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:player|get_watch)(?:\?[^#]*)?$|^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/player\/ad_break(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/YouTube/request.min.js,requires-body=true,binary-body-mode=true,timeout=10,argument=[{log_enabled},{log_level},{capture_budget},{playback_region}],tag=YouTube 播放请求与广告配置处理

# Bottom bar (guide endpoint, iOS app): removes the Shorts tab and the Create button when the switches are on. Always matched so either switch can enable it, the script passes the response through when both are off. Added 2026-10-31.
http-response ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.)?youtube\.com)\/youtubei\/v1\/guide(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/YouTube/response.min.js,requires-body=true,binary-body-mode=true,timeout=10,argument=[{log_enabled},{log_level},{capture_budget},{hide_shorts_tab},{hide_create_button}],tag=YouTube bottom bar Shorts tab and Create button
# Search responses (protobuf, iOS app) are cleaned too: sponsored results and their dividers. The in-feed ad the Home feed loads a few seconds later (deferred update) is removed as well. Updated 2026-10-25.
http-response ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(browse|next|search)(\?[^#]*)?$ script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/YouTube/response.min.js,requires-body=true,binary-body-mode=true,timeout=10,argument=[{log_enabled},{log_level},{capture_budget},{hide_home_shorts},{blocked_channels},{blocked_channels_url}],tag=YouTube 信息流广告与首页 Shorts 处理
http-response ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(player|get_watch)(\?[^#]*)?$|^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/reel\/reel_watch_sequence(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/YouTube/response.min.js,requires-body=true,binary-body-mode=true,timeout=10,argument=[{log_enabled},{log_level},{capture_budget},{background_playback},{quality_research}],tag=YouTube 播放响应与后台播放

[Mitm]
hostname = youtubei.googleapis.com, youtubei-att.googleapis.com, youtube.com, www.youtube.com, m.youtube.com, music.youtube.com, *.googlevideo.com
# 日志关闭时,init 和常规媒体响应都不会运行正文采样脚本。init POST 由原生空白视频重写处理,常规播放请求仍会清理广告协商。
# googlevideo 的 UDP 只回退到 TCP,常规 videoplayback 媒体请求仍被允许。
